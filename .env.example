# Discord bot token (required) - get from https://discord.com/developers/applications
POCKETPAW_DISCORD_BOT_TOKEN=your-bot-token-here

# Lock bot to your server (comma-separated guild IDs)
# POCKETPAW_DISCORD_ALLOWED_GUILD_IDS=[123456789012345678]

# Optional: restrict to specific channels
# POCKETPAW_DISCORD_ALLOWED_CHANNEL_IDS=[123456789012345678]

# Optional: restrict to specific users
# POCKETPAW_DISCORD_ALLOWED_USER_IDS=[123456789012345678]

# --- LLM Backend ---
# Option 1: openai_agents (lightweight, direct API calls, recommended for chat)
# Option 2: claude_agent_sdk (full agent with tools, needs Claude Code CLI)
POCKETPAW_AGENT_BACKEND=openai_agents

# --- LiteLLM Proxy ---
# These work for BOTH backends. Claude Code CLI picks up ANTHROPIC_BASE_URL natively.
ANTHROPIC_BASE_URL=http://your-litellm-host:4000
ANTHROPIC_API_KEY=sk-your-litellm-key

# Model name with provider prefix (required for LiteLLM)
POCKETPAW_CLAUDE_SDK_MODEL=anthropic/claude-sonnet-4-6

# For openai_agents backend, also set these:
POCKETPAW_LLM_PROVIDER=openai_compatible
POCKETPAW_OPENAI_COMPATIBLE_BASE_URL=http://your-litellm-host:4000
POCKETPAW_OPENAI_COMPATIBLE_API_KEY=sk-your-litellm-key
POCKETPAW_OPENAI_COMPATIBLE_MODEL=claude-sonnet-4-6

# Optional: bot display name and status
# POCKETPAW_DISCORD_BOT_NAME=Paw
# POCKETPAW_DISCORD_STATUS_TYPE=online
# POCKETPAW_DISCORD_ACTIVITY_TYPE=watching
# POCKETPAW_DISCORD_ACTIVITY_TEXT=your code
